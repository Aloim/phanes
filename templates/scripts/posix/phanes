#!/bin/sh
# phanes-template v3.4.0 phanes
# Dispatcher. Routes `phanes <subcommand> [args]` to the sibling script in this directory.
# Resolves siblings by this script's own location, so it works from any working directory.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ "$#" -lt 1 ]; then
  echo "phanes: subcommands: new-file loc-check doc-check register-check doc-index module-list list-apis regen-registry api-diff"
  exit 0
fi

sub=$1
shift

# repo-manifest, batch-apply, and the v3.4 bootstrap set ship Windows-only in v3.4; the
# POSIX port is deferred. Refusing here by name keeps a deferred command from
# masquerading as a typo.
case "$sub" in
  repo-manifest|batch-apply|preflight|install-templates|scaffold|ledger|hook-ledger-status|manifest-write|census-diff|update-preflight)
    echo "phanes: '$sub' is not available on this platform yet (Windows only in v3.4); the POSIX port is planned" >&2
    exit 1
    ;;
esac

if [ -f "$here/$sub.sh" ]; then
  exec sh "$here/$sub.sh" "$@"
elif [ -f "$here/$sub" ]; then
  exec sh "$here/$sub" "$@"
else
  echo "phanes: unknown subcommand '$sub' (no $sub.sh in $here)" >&2
  exit 1
fi
